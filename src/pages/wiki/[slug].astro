---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Infobox from '../../components/Infobox.astro';
import { SITE, editUrl, historyUrl } from '../../lib/site';
import { slugifyCategory } from '../../lib/slug';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, categories, infobox, stub } = entry.data;
---
<Base title={title} description={summary}>
  <div class="wig-tabs">
    <span class="active">Article</span>
    <a href={`${SITE.repo}/issues`} target="_blank" rel="noopener">Talk</a>
    <span style="margin-left:auto"></span>
    <span class="active">Read</span>
    <a href={editUrl(entry.id)} target="_blank" rel="noopener">Edit on GitHub</a>
    <a href={historyUrl(entry.id)} target="_blank" rel="noopener">View history</a>
  </div>

  {infobox && (
    <Infobox
      title={title}
      caption={infobox.caption}
      image={infobox.image}
      imageAlt={infobox.imageAlt}
      rows={infobox.rows}
    />
  )}

  <div data-pagefind-body>
    <h1 class="wig-title" data-pagefind-meta="title">{title}</h1>
    <p class="wig-fromline">From Wigipedia, the free hair encyclopedia</p>
    <div class="wig-body">
      {stub && (
        <p class="wig-stub">
          This hair-related article is a <strong>stub</strong>. You can help Wigipedia by
          combing it out and making it longer.
        </p>
      )}
      <Content />
    </div>
  </div>

  {categories.length > 0 && (
    <div class="wig-catbar">
      <strong>Categories:</strong>
      {categories.map((c) => <a href={`/category/${slugifyCategory(c)}`}>{c}</a>)}
    </div>
  )}
</Base>
